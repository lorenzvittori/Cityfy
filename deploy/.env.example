# Values of docker-compose.yml. In production this file is written by the Deploy workflow from the
# GitHub secrets and variables (see DEPLOY.md): copy it only to run the compose by hand.
# Use letters and digits for the passwords (no quotes).

# Images: ghcr.io/<github owner in lowercase>, tag = commit sha
REGISTRY=ghcr.io/owner
TAG=latest

# Public domain pointing to the server (e.g. a free DuckDNS name)
DOMAIN=cityfy.example.duckdns.org

MONGO_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me

# Azure SQL Database (free offer), database "musicbrainz"
MUSICBRAINZ_SQL_CONNECTION=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=musicbrainz;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;

# Last.fm application (https://www.last.fm/api/account/create)
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
