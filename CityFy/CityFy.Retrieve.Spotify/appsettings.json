{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5068", "https://localhost:7028" ]
  },
  "Spotify": {
    "ApiBase": "https://api.spotify.com/v1",
    "PageSize": 50,
    "ClientId": "aefb4c48d30042b0a68f1b0d0baa4bfe",
    "RedirectUri": "http://127.0.0.1:4200/api/v1/auth/callback",
    "Scopes": "user-read-recently-played user-read-private"
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "NLogConfigFile": "nlog.config",
  "NLog": {
    "autoReload": true,
    "internalLogLevel": "Info",
    "internalLogFile": "internal-nlog.log"
  }
}

