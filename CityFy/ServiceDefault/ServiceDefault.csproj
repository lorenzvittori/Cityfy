<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<IsAspireSharedProject>true</IsAspireSharedProject>
  </PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- 10.x to stay aligned with the net10.0 shared framework -->
		<PackageReference Include="Aspire.MongoDB.Driver" Version="13.6.5" />
		<PackageReference Include="Aspire.RabbitMQ.Client" Version="13.6.5" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
		<PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
		<PackageReference Include="MongoDB.Driver" Version="3.11.2" />
		<PackageReference Include="NLog" Version="5.3.0" />
		<PackageReference Include="NLog.Extensions.Logging" Version="5.3.0" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
