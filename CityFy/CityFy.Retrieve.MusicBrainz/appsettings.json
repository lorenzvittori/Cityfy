
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DebugUpload": {
    "RootPath": "",
    "MaxUploadSizeBytes": 200000000
  },
  "Mongo": {
    "ConnectionString": "mongodb://admin:password@localhost:27017/cityfy_spotify?authSource=admin",
    "Database": "cityfy_spotify",
    "CollectionPrefix": "streaming_history_"
  }
  ,
  "NLogConfigFile": "nlog.config",
  "NLog": {
    "autoReload": true,
    "internalLogLevel": "Info",
    "internalLogFile": "internal-nlog.log"
  }
}


