{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5068", "https://localhost:7028" ]
  },
  "DumpStorage": {
    "RootPath": ""
  },
  "NLogConfigFile": "nlog.config",
  "NLog": {
    "autoReload": true,
    "internalLogLevel": "Info",
    "internalLogFile": "internal-nlog.log"
  }
}
