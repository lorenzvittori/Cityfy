{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LastFm": {
    "ApiBase": "https://ws.audioscrobbler.com/2.0/",
    "AuthUrl": "https://www.last.fm/api/auth/",
    "CallbackUrl": "http://127.0.0.1:4200/api/v1/auth/lastfm/callback",
    "MaxRequestsPerSecond": 4,
    "PageSize": 200
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "NLogConfigFile": "nlog.config",
  "NLog": {
    "autoReload": true,
    "internalLogLevel": "Info",
    "internalLogFile": "internal-nlog.log"
  }
}
